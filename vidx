#!/bin/sh
# vidx from a source checkout on macOS and Linux: runs the Python package in src/ (see README.md).
# Installed copies and Windows use the `vidx` console script instead (uv tool install).
set -eu
self=$0
while [ -L "$self" ]; do  # follow symlinks to this file (e.g. ~/bin/vidx -> checkout/vidx)
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
dir=$(cd "$(dirname "$self")" && pwd -P)
export PYTHONPATH="$dir/src"
# -P: the current directory never goes on sys.path; -s: no user site-packages
if [ -x "$dir/.venv/bin/python" ]; then exec "$dir/.venv/bin/python" -P -s -m vidx "$@"; fi  # after vidx setup
if command -v uv >/dev/null 2>&1; then exec uv run -q --no-project --python ">=3.14" python -P -s -m vidx "$@"; fi
exec python3 -P -s -m vidx "$@"  # Python 3.14 or newer
